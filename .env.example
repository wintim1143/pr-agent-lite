# =============================================================================
# 环境变量模板 —— 复制为 `.env` 后按部署环境填写
# =============================================================================
#
# ⚠️ 三条原则，改这个文件时请一并遵守：
#
#   1. **不放真实值**。凭据、地址、路径一律留空 —— 模板进仓库，`.env` 不进。
#   2. **不写机器路径**。`localPath` 这类本机事实由仓库注册表提供（见文末），
#      不在这里写死 —— 写死就等于把「某台机器的布局」编进配置。
#   3. **留空的含义是「用默认值」，不是「用空值」**。多数项留空即可跑。
#
# 两项启动自检（`npm start` 与每次运行）都会打印**实际生效**的 provider /
# baseURL / model —— 端点不通也打印。配错时的第一手依据就在那几行里。
# =============================================================================


# ── 闸门链（test / review / commit 三个语义闸门）─────────────────────────────
# OpenAI Chat Completions 形状。请求固定拼 `{LLM_BASE_URL}/chat/completions`。
# 是否带 `/v1` 由服务商决定：DeepSeek 官方**不带**，多数中转站**带**。
LLM_PROVIDER=relay          # `relay`（中转站，baseURL 必填）或 `deepseek`（官方，有默认值）
LLM_MODEL=                  # 留空取 provider 默认值
LLM_BASE_URL=               # 留空取 provider 默认值
LLM_API_KEY=                # 必填
LLM_TIMEOUT_MS=120000       # 单次闸门调用超时
GATE_MAX_ATTEMPTS=3         # 闸门重试上限（重试会把上次的 zod 报错回灌，不是盲重试）

# ── 编码链（真正写文件的那一侧）─────────────────────────────────────────────
# ⚠️ 与闸门链**互不假定**：凭据、端点、模型都可以不同，这是两套独立配置。
# 不设 `CODING_ANTHROPIC_*` 时继承进程环境，由 CLI 自己读用户级 settings 里的 env 块。
# ⚠️ 设了 `CODING_ANTHROPIC_*` 时它们会被送进 **settings 层**（等价 CLI 的 `--settings`）——
#    因为 CLI 会读 `~/.claude/settings.json` 的 `env` 块，而**那一层压过进程环境变量**。
#    只注入进程 env 的后果是**静默打到别的端点**：跑得起来、日志正常，但请求去了别处。
CODING_CLI_PATH=            # 编码 CLI 的绝对路径。留空用 SDK 内置。
                            # ⚠️ 非交互 shell 的 PATH 里没有用户级 bin 目录 —— 用绝对路径，不要建系统级软链。
CODING_ANTHROPIC_BASE_URL=  # 编码后端端点（Anthropic 协议）
CODING_ANTHROPIC_API_KEY=   # 编码后端密钥（与 ANTHROPIC_AUTH_TOKEN 二选一，视服务商而定）
CODING_ANTHROPIC_AUTH_TOKEN=
CODING_ANTHROPIC_MODEL=     # 编码模型名。⚠️ 部分服务商对未知模型名**静默回落** —— 启动自检会把它打出来
CODING_API_TIMEOUT_MS=180000  # 单请求超时（CLI 会在超时后自动重试）。设 0 关闭注入
CODING_TIMEOUT_MS=600000      # 整个编码步的墙上时钟上限（超时即判本次编码失败）
CODING_MAX_TURNS=30           # 无人值守的轮次上限
CODING_MAX_BUDGET_USD=2       # 无人值守的成本上限。
                              # ⚠️ 这是 **Claude Code CLI 用自带价目表算出的名义成本**，
                              #    编码链接中转站 / 非 Anthropic 官方端点时**与实际计费无关**，
                              #    却照样能拦腰截断一次正常编码（实测撞到过：跑了 249s 后
                              #    以 `Reached maximum budget ($2)` 失败）。接中转站时先调大。
                              #    三个上限都会被启动自检打印出来。
CODING_REPO_ROOT=             # 仅单仓库模式用。多仓库请改用注册表（见文末）


# ── 运行期落点（全部来自配置，代码里不写死）────────────────────────────────
PRAL_DB_PATH=               # 状态库文件。留空为进程工作目录下的默认名
PRAL_PROGRESS_FILE=         # 结构化日志文件。留空为工作目录下的 `logs/<默认名>.log`
PRAL_PROGRESS_LOG=          # 设 `0` 完全关闭落盘与镜像（**不建议**：日志是唯一真相源）
PRAL_LOG_MAX_BYTES=5242880  # 单日志文件超过即轮转；`0` = 不轮转
PRAL_LOG_KEEP=5             # 保留的轮转份数
PRAL_HEARTBEAT_MS=30000     # 编码期间心跳间隔；`0` = 关闭

# ── 仓库互斥锁（跨进程；临界区 = checkout → commit）─────────────────────────
REPO_LOCK_WAIT_MS=600000
REPO_LOCK_TTL_MS=1800000
REPO_LOCK_POLL_MS=1000

# ── 测试执行器（test 闸门里**由程序**跑命令取 exit code 的那一半）──────────
TEST_TIMEOUT_MS=               # 留空用内置默认
TEST_OUTPUT_MAX_CHARS=         # 留空用内置默认
TEST_GUARD_MODIFY_TESTS=block  # agent 改动既有测试文件时的策略：`block` / 其他（见代码）

# ── 状态页 ─────────────────────────────────────────────────────────────────
STATUS_HOST=127.0.0.1       # ⚠️ 默认只监听回环。页面含本机真实路径，不要默认对全网开放
STATUS_PORT=8787
STATUS_PUSH_MS=3000         # SSE 推送间隔
STATUS_TAIL_LIMIT=200       # 单次推送最多带多少条事件

# ── 状态库 ─────────────────────────────────────────────────────────────────
SQLITE_BUSY_TIMEOUT_MS=5000 # 写竞争等待上限。⚠️ 驱动默认是 0（不等待），必须显式设置

# ── 代码平台通道（**第一版不用**）───────────────────────────────────────────
# 第一版不含 push / 开 PR：编码跑完 commit 即止。接真仓库时再填。
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
COMMIT_DIFF_MAX_CHARS=8000
GIT_PROXY=

# ── 仓库注册表（多仓库模式必需）────────────────────────────────────────────
# 文件内容形如：
#   { "repos": { "<owner>/<repo>": { "localPath": "<本机 clone 路径>", "baseBranch": "main" } } }
# ⚠️ `localPath` 只存在于**这个文件**里，不进日志、不进 run 上下文快照 ——
#    否则换台机器 resume 就会指向一个不存在的目录。
# ⚠️ 键必须是逻辑标识 `owner/repo`；写成路径会被显式拒绝（不回退、不猜测）。
REPO_REGISTRY_PATH=
